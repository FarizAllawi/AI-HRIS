groups:
  - name: fastapi_alerts
    rules:
      # Service down
      - alert: FastAPIDown
        expr: up{job="fastapi"} == 0
        for: 1m
        labels:
          severity: critical
          service: fastapi
          team: backend
        annotations:
          summary: "FastAPI service is down"
          description: "FastAPI service has been down for more than 1 minute"
          runbook_url: "https://wiki.company.com/runbooks/fastapi-down"

      # High error rate
      - alert: HighFastAPIErrorRate
        expr: |
          (
            rate(http_requests_total{status=~"5..", job="fastapi"}[5m])
            /
            rate(http_requests_total{job="fastapi"}[5m])
          ) > 0.05
        for: 3m
        labels:
          severity: critical
          service: fastapi
          team: backend
        annotations:
          summary: "High error rate in FastAPI application"
          description: "FastAPI error rate is {{ $value | humanizePercentage }} - above 5% threshold"

      # High response latency
      - alert: HighFastAPILatency
        expr: |
          histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job="fastapi"}[5m])) > 3
        for: 5m
        labels:
          severity: warning
          service: fastapi
          team: backend
        annotations:
          summary: "High latency in FastAPI application"
          description: "95th percentile latency is {{ $value | humanize }}s - above 3s threshold"

      # High memory usage
      - alert: FastAPIHighMemory
        expr: |
          process_resident_memory_bytes{job="fastapi"} > 1.5e9
        for: 5m
        labels:
          severity: warning
          service: fastapi
          team: backend
        annotations:
          summary: "High memory usage in FastAPI"
          description: "FastAPI memory usage is {{ $value | humanize }} bytes"

  - name: redis_alerts
    rules:
      # Redis down
      - alert: RedisDown
        expr: redis_up == 0
        for: 1m
        labels:
          severity: critical
          service: redis
          team: infrastructure
        annotations:
          summary: "Redis is down"
          description: "Redis instance has been down for more than 1 minute"

      # High memory usage
      - alert: RedisMemoryHigh
        expr: |
          redis_memory_used_bytes / (1024*1024*1024) > 0.8
        for: 5m
        labels:
          severity: warning
          service: redis
          team: infrastructure
        annotations:
          summary: "Redis memory usage is high"
          description: "Redis memory usage is {{ $value | humanize }}GB (80% of max)"

      # Many connected clients
      - alert: RedisManyConnections
        expr: |
          redis_connected_clients > 50
        for: 5m
        labels:
          severity: warning
          service: redis
          team: infrastructure
        annotations:
          summary: "Redis has many connected clients"
          description: "Redis has {{ $value }} connected clients"

      # High evicted keys
      - alert: RedisHighEvictions
        expr: |
          rate(redis_evicted_keys_total[5m]) > 10
        for: 2m
        labels:
          severity: warning
          service: redis
          team: infrastructure
        annotations:
          summary: "Redis is evicting many keys"
          description: "Redis is evicting {{ $value }} keys per second"

  - name: postgres_alerts
    rules:
      # PostgreSQL down
      - alert: PostgresDown
        expr: pg_up == 0
        for: 1m
        labels:
          severity: critical
          service: postgres
          team: database
        annotations:
          summary: "PostgreSQL is down"
          description: "PostgreSQL instance has been down for more than 1 minute"

      # High connection count
      - alert: PostgresTooManyConnections
        expr: |
          pg_stat_activity_count > 70
        for: 3m
        labels:
          severity: warning
          service: postgres
          team: database
        annotations:
          summary: "PostgreSQL has too many connections"
          description: "PostgreSQL has {{ $value }} connections (max: 100)"

      # Database locks
      - alert: PostgresDatabaseLocks
        expr: |
          pg_locks_count > 20
        for: 2m
        labels:
          severity: warning
          service: postgres
          team: database
        annotations:
          summary: "PostgreSQL has many locks"
          description: "PostgreSQL has {{ $value }} active locks"

      # Slow queries
      - alert: PostgresSlowQueries
        expr: |
          avg by (query) (pg_stat_statements_mean_time) > 1
        for: 5m
        labels:
          severity: warning
          service: postgres
          team: database
        annotations:
          summary: "PostgreSQL has slow queries"
          description: "Average query time is {{ $value }} seconds"

  - name: celery_alerts
    rules:
      # Celery worker down
      - alert: CeleryWorkerDown
        expr: |
          celery_workers < 2
        for: 3m
        labels:
          severity: critical
          service: celery
          team: backend
        annotations:
          summary: "Celery workers are down"
          description: "Only {{ $value }} Celery workers are running"

      # High task failure rate
      - alert: CeleryHighFailureRate
        expr: |
          rate(celery_tasks_failed_total[10m])
          /
          rate(celery_tasks_total[10m]) > 0.05
        for: 5m
        labels:
          severity: warning
          service: celery
          team: backend
        annotations:
          summary: "High Celery task failure rate"
          description: "Celery task failure rate is {{ $value | humanizePercentage }}"

      # Queue backlog
      - alert: CeleryQueueBacklog
        expr: |
          celery_tasks_active > 500
        for: 10m
        labels:
          severity: warning
          service: celery
          team: backend
        annotations:
          summary: "Celery queue backlog"
          description: "Celery has {{ $value }} tasks in active state"

      # Long running tasks
      - alert: CeleryLongRunningTasks
        expr: |
          time() - celery_task_start_time > 300
        for: 2m
        labels:
          severity: warning
          service: celery
          team: backend
        annotations:
          summary: "Celery tasks running too long"
          description: "Tasks running for more than 5 minutes detected"

  - name: system_alerts
    rules:
      # High CPU usage
      - alert: HighCPUUsage
        expr: |
          100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
        for: 5m
        labels:
          severity: warning
          team: infrastructure
        annotations:
          summary: "High CPU usage on {{ $labels.instance }}"
          description: "CPU usage is at {{ $value | humanize }}%"

      # High memory usage
      - alert: HighMemoryUsage
        expr: |
          (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > 85
        for: 5m
        labels:
          severity: warning
          team: infrastructure
        annotations:
          summary: "High memory usage on {{ $labels.instance }}"
          description: "Memory usage is at {{ $value | humanize }}%"

      # Disk space running out
      - alert: DiskSpaceLow
        expr: |
          (1 - (node_filesystem_avail_bytes{fstype!="tmpfs"} / node_filesystem_size_bytes)) * 100 > 80
        for: 5m
        labels:
          severity: warning
          team: infrastructure
        annotations:
          summary: "Low disk space on {{ $labels.instance }}"
          description: "Disk usage on {{ $labels.mountpoint }} is at {{ $value | humanize }}%"

      # Disk predicted to fill in 24h
      - alert: DiskWillFillSoon
        expr: |
          predict_linear(node_filesystem_avail_bytes{fstype!="tmpfs"}[6h], 24*3600) < 0
        for: 5m
        labels:
          severity: critical
          team: infrastructure
        annotations:
          summary: "Disk will fill within 24 hours on {{ $labels.instance }}"
          description: "Based on current growth rate, disk will fill within 24 hours"

      # High IO utilization
      - alert: HighDiskIO
        expr: |
          rate(node_disk_io_time_seconds_total[5m]) * 100 > 80
        for: 5m
        labels:
          severity: warning
          team: infrastructure
        annotations:
          summary: "High disk I/O utilization on {{ $labels.instance }}"
          description: "Disk I/O utilization is at {{ $value | humanize }}%"

      # High network errors
      - alert: HighNetworkErrors
        expr: |
          rate(node_network_receive_errs_total[5m]) + rate(node_network_transmit_errs_total[5m]) > 10
        for: 2m
        labels:
          severity: warning
          team: infrastructure
        annotations:
          summary: "High network error rate on {{ $labels.instance }}"
          description: "Network error rate is {{ $value }} errors per second"

  - name: container_alerts
    rules:
      # Container restarting frequently
      - alert: ContainerFrequentlyRestarting
        expr: |
          rate(container_restarts_total[10m]) > 0.1
        for: 2m
        labels:
          severity: warning
          team: infrastructure
        annotations:
          summary: "Container frequently restarting: {{ $labels.container }}"
          description: "Container {{ $labels.container }} is restarting frequently"

      # Container high memory usage
      - alert: ContainerHighMemory
        expr: |
          container_memory_usage_bytes / container_spec_memory_limit_bytes > 0.8
        for: 5m
        labels:
          severity: warning
          team: infrastructure
        annotations:
          summary: "Container high memory usage: {{ $labels.container }}"
          description: "Container {{ $labels.container }} memory usage is {{ $value | humanizePercentage }}"

      # Container high CPU usage
      - alert: ContainerHighCPU
        expr: |
          rate(container_cpu_usage_seconds_total[5m]) * 100 > 80
        for: 5m
        labels:
          severity: warning
          team: infrastructure
        annotations:
          summary: "Container high CPU usage: {{ $labels.container }}"
          description: "Container {{ $labels.container }} CPU usage is {{ $value | humanize }}%"
