groups:
  - name: recording_rules
    interval: 30s
    rules:
      # FastAPI recording rules
      - record: job:fastapi:http_requests:rate5m
        expr: rate(http_requests_total{job="fastapi"}[5m])

      - record: job:fastapi:http_errors:rate5m
        expr: rate(http_requests_total{status=~"5..", job="fastapi"}[5m])

      - record: job:fastapi:http_request_duration_seconds:p95
        expr: histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job="fastapi"}[5m]))

      - record: job:fastapi:http_request_duration_seconds:p99
        expr: histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job="fastapi"}[5m]))

      - record: job:fastapi:error_ratio
        expr: |
          job:fastapi:http_errors:rate5m
          /
          job:fastapi:http_requests:rate5m

      # Redis recording rules
      - record: instance:redis:memory_usage_percentage
        expr: redis_memory_used_bytes / (1024*1024*1024) * 100

      - record: instance:redis:connected_clients:rate5m
        expr: rate(redis_connected_clients[5m])

      # PostgreSQL recording rules
      - record: instance:postgres:connection_usage_percentage
        expr: pg_stat_activity_count / 100 * 100

      - record: instance:postgres:dead_tuples
        expr: pg_stat_user_tables_n_dead_tup

      # System recording rules
      - record: instance:node_cpu:usage:rate5m
        expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100)

      - record: instance:node_memory_usage:percentage
        expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100

      - record: instance:node_disk_usage:percentage
        expr: (1 - (node_filesystem_avail_bytes{fstype!="tmpfs"} / node_filesystem_size_bytes)) * 100

      # Celery recording rules
      - record: job:celery:task_rate:rate5m
        expr: rate(celery_tasks_total[5m])

      - record: job:celery:task_failure_rate:rate5m
        expr: rate(celery_tasks_failed_total[5m])

      - record: job:celery:task_failure_ratio
        expr: |
          job:celery:task_failure_rate:rate5m
          /
          job:celery:task_rate:rate5m

      # Business metrics
      - record: business:screening_requests:rate5m
        expr: rate(screening_requests_total[5m])

      - record: business:screening_success_ratio
        expr: |
          rate(screening_requests_total{status="success"}[5m])
          /
          rate(screening_requests_total[5m])

      - record: business:average_screening_duration
        expr: rate(screening_duration_seconds_sum[5m]) / rate(screening_duration_seconds_count[5m])
