{
  "dashboard": {
    "id": null,
    "title": "PostgreSQL - Database",
    "tags": ["postgres", "database", "production"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Database Status",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "pg_up",
            "legendFormat": "PostgreSQL Up",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "custom": {"displayMode": "lcd"},
            "decimals": 0,
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {"text": "DOWN"},
                  "1": {"text": "UP"}
                }
              }
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Active Connections",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "pg_stat_activity_count",
            "legendFormat": "Active Connections",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "custom": {"displayMode": "lcd"},
            "decimals": 0,
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 80}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Database Size",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "pg_database_size_bytes{datname=\"screening_db\"} / (1024*1024*1024)",
            "legendFormat": "DB Size",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {"displayMode": "lcd"},
            "decimals": 2,
            "unit": "GB"
          }
        }
      },
      {
        "id": 4,
        "title": "Transactions Rate",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_commit{datname=\"screening_db\"}[5m]) + rate(pg_stat_database_xact_rollback{datname=\"screening_db\"}[5m])",
            "legendFormat": "Transactions/s",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {"displayMode": "lcd"},
            "decimals": 0,
            "unit": "tps"
          }
        }
      },
      {
        "id": 5,
        "title": "Active Connections Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "pg_stat_activity_count",
            "legendFormat": "Active Connections",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2
            },
            "decimals": 0
          }
        }
      },
      {
        "id": 6,
        "title": "Transactions Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_commit{datname=\"screening_db\"}[5m])",
            "legendFormat": "Commits/s",
            "refId": "A"
          },
          {
            "expr": "rate(pg_stat_database_xact_rollback{datname=\"screening_db\"}[5m])",
            "legendFormat": "Rollbacks/s",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2
            },
            "unit": "tps",
            "decimals": 2
          }
        }
      },
      {
        "id": 7,
        "title": "Tuples Activity",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "rate(pg_stat_database_tup_returned{datname=\"screening_db\"}[5m])",
            "legendFormat": "Returned/s",
            "refId": "A"
          },
          {
            "expr": "rate(pg_stat_database_tup_fetched{datname=\"screening_db\"}[5m])",
            "legendFormat": "Fetched/s",
            "refId": "B"
          },
          {
            "expr": "rate(pg_stat_database_tup_inserted{datname=\"screening_db\"}[5m])",
            "legendFormat": "Inserted/s",
            "refId": "C"
          },
          {
            "expr": "rate(pg_stat_database_tup_updated{datname=\"screening_db\"}[5m])",
            "legendFormat": "Updated/s",
            "refId": "D"
          },
          {
            "expr": "rate(pg_stat_database_tup_deleted{datname=\"screening_db\"}[5m])",
            "legendFormat": "Deleted/s",
            "refId": "E"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 1
            },
            "unit": "ops",
            "decimals": 0
          }
        }
      },
      {
        "id": 8,
        "title": "Database Locks",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "pg_locks_count",
            "legendFormat": "Total Locks",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2
            },
            "decimals": 0
          }
        }
      },
      {
        "id": 9,
        "title": "Buffer Cache Hit Ratio",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "pg_stat_database_blks_hit{datname=\"screening_db\"} / (pg_stat_database_blks_hit{datname=\"screening_db\"} + pg_stat_database_blks_read{datname=\"screening_db\"}) * 100",
            "legendFormat": "Cache Hit Ratio %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2
            },
            "unit": "percent",
            "decimals": 1,
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 10,
        "title": "Dead Tuples by Table",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "pg_stat_user_tables_n_dead_tup",
            "legendFormat": "{{relname}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 1
            },
            "decimals": 0
          }
        }
      },
      {
        "id": 11,
        "title": "Table Sizes",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "pg_table_size_bytes / (1024*1024)",
            "legendFormat": "{{relname}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "displayMode": "lcd"
            },
            "unit": "MB",
            "decimals": 0
          }
        }
      },
      {
        "id": 12,
        "title": "Index Usage",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "rate(pg_stat_user_indexes_idx_scan[5m])",
            "legendFormat": "{{schemaname}}.{{indexname}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 1
            },
            "unit": "ops",
            "decimals": 0
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {},
    "refresh": "15s",
    "schemaVersion": 37,
    "version": 1,
    "uid": "postgres-dashboard"
  }
}
